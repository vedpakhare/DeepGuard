from io import BytesIO
import cv2
import numpy as np
from fastapi import FastAPI, File, UploadFile
from fastapi.responses import JSONResponse, StreamingResponse
from PIL import Image

app = FastAPI(title="Zero-Latency Backend", version="1.0.0")


@app.get("/health")
def health_check() -> dict[str, str]:
    return {"status": "ok", "message": "FastAPI backend is running"}


@app.post("/process-image")
async def process_image(file: UploadFile = File(...)) -> StreamingResponse:
    if not file.filename or not file.filename.lower().endswith((".png", ".jpg", ".jpeg", ".webp", ".bmp")):
        return JSONResponse(status_code=400, content={"error": "Unsupported file type"})

    contents = await file.read()
    image = Image.open(BytesIO(contents)).convert("RGB")
    cv_image = cv2.cvtColor(np.array(image), cv2.COLOR_RGB2BGR)
    gray = cv2.cvtColor(cv_image, cv2.COLOR_BGR2GRAY)
    _, thresholded = cv2.threshold(gray, 127, 255, cv2.THRESH_BINARY)
    result_image = Image.fromarray(cv2.cvtColor(thresholded, cv2.COLOR_GRAY2RGB))

    output = BytesIO()
    result_image.save(output, format="PNG")
    output.seek(0)

    return StreamingResponse(output, media_type="image/png")
